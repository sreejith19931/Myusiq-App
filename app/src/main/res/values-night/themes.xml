<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme_Rhythm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme_Rhythm" parent="Base.Theme_Rhythm">
        <item name="colorPrimary">@color/md_theme_default_primary</item>
        <item name="bottomNavigationStyle">@style/Widget.Material3.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenBackground">#1A1A1A</item>
        <item name="postSplashScreenTheme">@style/Theme_Rhythm</item>
    </style>

    <!-- Dark Mode Palettes: Use Dark Backgrounds for contrast -->
    <style name="Theme.Palette.Red" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_red</item>
        <item name="colorSecondary">@color/rainbow_red</item>
        <item name="colorSurface">#1A1110</item>
        <item name="android:colorBackground">#1A1110</item>
        <item name="colorOnSurface">#F4E0DF</item>
        <item name="colorOnBackground">#F4E0DF</item>
    </style>

    <style name="Theme.Palette.Orange" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_orange</item>
        <item name="colorSecondary">@color/rainbow_orange</item>
        <item name="colorSurface">#1A1208</item>
        <item name="android:colorBackground">#1A1208</item>
        <item name="colorOnSurface">#F5E1D6</item>
        <item name="colorOnBackground">#F5E1D6</item>
    </style>

    <style name="Theme.Palette.Yellow" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_yellow</item>
        <item name="colorSecondary">@color/rainbow_yellow</item>
        <item name="colorSurface">#1A1805</item>
        <item name="android:colorBackground">#1A1805</item>
        <item name="colorOnSurface">#F5F3D1</item>
        <item name="colorOnBackground">#F5F3D1</item>
    </style>

    <style name="Theme.Palette.Green" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_green</item>
        <item name="colorSecondary">@color/rainbow_green</item>
        <item name="colorSurface">#0A1A0C</item>
        <item name="android:colorBackground">#0A1A0C</item>
        <item name="colorOnSurface">#D5E8D9</item>
        <item name="colorOnBackground">#D5E8D9</item>
    </style>

    <style name="Theme.Palette.Blue" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_blue</item>
        <item name="colorSecondary">@color/rainbow_blue</item>
        <item name="colorSurface">#08121A</item>
        <item name="android:colorBackground">#08121A</item>
        <item name="colorOnSurface">#D6E3F5</item>
        <item name="colorOnBackground">#D6E3F5</item>
    </style>

    <style name="Theme.Palette.Indigo" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_indigo</item>
        <item name="colorSecondary">@color/rainbow_indigo</item>
        <item name="colorSurface">#0B0D1A</item>
        <item name="android:colorBackground">#0B0D1A</item>
        <item name="colorOnSurface">#D7D9E8</item>
        <item name="colorOnBackground">#D7D9E8</item>
    </style>

    <style name="Theme.Palette.Violet" parent="Theme_Rhythm">
        <item name="colorPrimary">@color/rainbow_violet</item>
        <item name="colorSecondary">@color/rainbow_violet</item>
        <item name="colorSurface">#150A1A</item>
        <item name="android:colorBackground">#150A1A</item>
        <item name="colorOnSurface">#E8D5F5</item>
        <item name="colorOnBackground">#E8D5F5</item>
    </style>
</resources>
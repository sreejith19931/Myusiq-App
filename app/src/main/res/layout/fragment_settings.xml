<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:paddingBottom="180dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include
            android:id="@+id/settingsHeader"
            layout="@layout/layout_page_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Sound & Personalization Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound &amp; Personalization"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.music.myusiq.ui.components.SettingsHubItem
                    android:id="@+id/hubAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hubIcon="@drawable/ic_equalizer"
                    app:hubTitle="Playback &amp; Audio"
                    app:hubSubtitle="Equalizer, Crossfade, ReplayGain, Autoplay" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="20dp"/>

                <com.music.myusiq.ui.components.SettingsHubItem
                    android:id="@+id/hubAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hubIcon="@drawable/ic_palette"
                    app:hubTitle="Look &amp; Feel"
                    app:hubSubtitle="Themes, Colors, Glassmorphism, Visualizers" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="20dp"/>

                <com.music.myusiq.ui.components.SettingsHubItem
                    android:id="@+id/hubLyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hubIcon="@drawable/ic_edit"
                    app:hubTitle="Lyrics Settings"
                    app:hubSubtitle="Overlay, Minimalist, Focus Blur, Tap-to-seek" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Library & Storage Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Library &amp; System"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.music.myusiq.ui.components.SettingsHubItem
                    android:id="@+id/hubLibrary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hubIcon="@drawable/ic_search"
                    app:hubTitle="Library &amp; Storage"
                    app:hubSubtitle="Rescan, Filters, Library Janitor" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginHorizontal="20dp"/>

                <com.music.myusiq.ui.components.SettingsHubItem
                    android:id="@+id/hubMaintenance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hubIcon="@android:drawable/ic_menu_recent_history"
                    app:hubTitle="Backup &amp; Maintenance"
                    app:hubSubtitle="Data Export, Restore, Clear Lyrics, Reset"
                    app:hubIconTint="?attr/colorError" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Application Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            tools:ignore="HardcodedText" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <com.music.myusiq.ui.components.SettingsHubItem
                android:id="@+id/hubAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hubIcon="@drawable/ic_play"
                app:hubTitle="About Myusiq"
                app:hubSubtitle="Version info, updates, and changelog" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. Blurred Album Art Background -->
    <ImageView
        android:id="@+id/ivStageArtBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:importantForAccessibility="no" />

    <!-- Dark Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- 2. Integrated 60fps Visualizer Canvas Layer -->
    <com.music.myusiq.ui.components.FullscreenVisualizerView
        android:id="@+id/stageVisualizerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.65" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="20dp">

        <!-- Top Header Bar with Subtle Blended Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Three-Dots Visualizer Menu Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStageVisualizerMenu"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_more_vert"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@android:color/white"
                app:backgroundTint="#33FFFFFF"
                app:cornerSize="22dp"
                android:contentDescription="Visualizer Style Menu" />

            <!-- Close Stage Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStageClose"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@android:color/white"
                app:backgroundTint="#33FFFFFF"
                app:cornerSize="22dp"
                android:contentDescription="Close Stage" />
        </LinearLayout>

        <!-- 3. Scrolling Lyrics Stage RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStageLyrics"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="120dp"
            android:scrollbars="none" />

        <!-- 4. Minimalist Bottom Control Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#CC111111"
            app:cardCornerRadius="24dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FFFFFF"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStageTrackTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@android:color/white"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="Song Title" />

                        <TextView
                            android:id="@+id/tvStageArtistName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#B0BEC5"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="Artist Name" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStagePlayPause"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:icon="@drawable/ic_play"
                        app:iconSize="32dp"
                        app:iconTint="@android:color/white"
                        android:contentDescription="Play/Pause" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <SeekBar
                        android:id="@+id/sbStageProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@android:color/white"
                        android:thumbTint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvStageProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B0BEC5"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        tools:text="01:24 / 03:45" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</FrameLayout>
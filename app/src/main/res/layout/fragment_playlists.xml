<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:paddingBottom="20dp"
            android:gravity="center_horizontal">

            <include
                android:id="@+id/playlistsHeader"
                layout="@layout/layout_page_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Mood Preset Buttons -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/moodChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="false"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEnergize"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Energize"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:chipIcon="@drawable/ic_play" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRelax"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relax"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:chipIcon="@drawable/ic_music_note_2" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipParty"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Party"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:chipIcon="@drawable/ic_shuffle" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFocus"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:chipIcon="@drawable/ic_speed" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRomance"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mood_romance"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        app:chipIcon="@drawable/ic_heart_filled" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_playlist" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/create_playlist"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
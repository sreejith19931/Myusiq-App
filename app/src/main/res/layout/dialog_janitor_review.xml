<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvJanitorDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review Proposed Updates"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvJanitorDialogSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Compare current info vs found info and select which tracks to update."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Material 3 Expressive Progress & Shape Loading Animation Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutJanitorProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Material You Expressive Shape Loading Views -->
            <com.music.myusiq.ui.components.PulseLoadingView
                android:id="@+id/pulseLoadingView"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:visibility="visible" />

            <com.music.myusiq.ui.components.AnimatedLoadingBars
                android:id="@+id/animatedLoadingBars"
                android:layout_width="64dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <com.music.myusiq.ui.components.WritingLoadingView
                android:id="@+id/writingLoadingView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- Fallback Circular Progress Indicator -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressJanitorCircular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="52dp"
                app:trackThickness="5dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorPrimaryContainer" />

            <TextView
                android:id="@+id/tvJanitorProgressMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Scanning tracks &amp; analyzing waveforms..."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <!-- Material 3 Linear Progress Indicator for track updates -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressJanitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="false"
                android:visibility="gone"
                app:trackCornerRadius="6dp"
                app:trackThickness="6dp"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorPrimaryContainer" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutSelectAllContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Select All" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/frameReviewContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvJanitorReview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            tools:listitem="@layout/item_janitor_update_review" />

        <TextView
            android:id="@+id/tvNoMatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No updates or matches found."
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBulkSearchOnline"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Search All Messy Tracks Online" />

    <LinearLayout
        android:id="@+id/layoutDialogButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReview"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplySelected"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Apply Selected" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Custom Typography: The Pro Duo (Syne for Impact, Space Grotesk for Precision) -->

    <!-- DISPLAY & HEADLINES: Syne (High-end, artistic vibe) -->
    <style name="TextAppearance.Myusiq.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Myusiq.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Myusiq.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
    </style>

    <style name="TextAppearance.Myusiq.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle" tools:ignore="SpUsage">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.Myusiq.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
    </style>
    <style name="TextAppearance.Myusiq.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
    </style>

    <!-- TITLES: Syne (Matched with Player Headlines for brand consistency) -->
    <style name="TextAppearance.Myusiq.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
    </style>
    <style name="TextAppearance.Myusiq.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">800</item>
    </style>
    <style name="TextAppearance.Myusiq.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
    </style>

    <!-- BODY: Space Grotesk (Exceptional legibility for long text) -->
    <style name="TextAppearance.Myusiq.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
    </style>
    <style name="TextAppearance.Myusiq.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
    <style name="TextAppearance.Myusiq.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>

    <!-- LABELS: Space Grotesk (Technical look for UI metadata) -->
    <style name="TextAppearance.Myusiq.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.Myusiq.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    <style name="TextAppearance.Myusiq.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- BUTTONS: Space Grotesk (Changed to Space Grotesk for better consistency across all interactive elements) -->
    <style name="TextAppearance.Myusiq.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Theme Overlay to apply the Pro Pairing -->
    <style name="ThemeOverlay.App.CustomFonts" parent="ThemeOverlay.Material3">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:textViewStyle">@style/Widget.Myusiq.DefaultTextView</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Myusiq.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Myusiq.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Myusiq.DisplaySmall</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Myusiq.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Myusiq.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Myusiq.HeadlineSmall</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.Myusiq.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Myusiq.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Myusiq.TitleSmall</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.Myusiq.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Myusiq.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Myusiq.BodySmall</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.Myusiq.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Myusiq.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Myusiq.LabelSmall</item>

        <!-- Ensure Material3 buttons/chips and legacy buttons get the font -->
        <item name="textAppearanceButton">@style/TextAppearance.Myusiq.Button</item>
    </style>

    <style name="Widget.Myusiq.DefaultTextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
    </style>

    <style name="Widget.Myusiq.TextView.Title" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/syne</item>
        <item name="fontFamily">@font/syne</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Myusiq.TextView.Artist" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
    </style>
</resources>